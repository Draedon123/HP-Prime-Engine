{
  "compilerOptions": {
    "lib": ["esnext"],
    "target": "esnext",

    "verbatimModuleSyntax": true,
    "moduleResolution": "bundler",
    "module": "esnext",

    "types": ["node"],

    "strict": true,
    "strictBindCallApply": true,
    "strictBuiltinIteratorReturn": true,
    "strictFunctionTypes": true,
    "strictNullChecks": true,
    "strictPropertyInitialization": true
  }
}
